@startuml
set separator none
title L3 — Componentes | Monitoring Service (Iteración 2)

left to right direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

skinparam backgroundColor #141414
skinparam defaultFontName Arial
skinparam titleFontColor #E6E6E6
skinparam titleFontSize 20
skinparam titleFontStyle bold
skinparam ArrowFontColor #C8C8C8
skinparam dpi 150
UpdateRelStyle($textColor="#C8C8C8", $lineColor="#8A8A8A")
UpdateBoundaryStyle($elementName="system", $fontColor="#BFBFBF", $borderColor="#7A7A7A", $bgColor="transparent")
UpdateBoundaryStyle($elementName="container", $fontColor="#BFBFBF", $borderColor="#7A7A7A", $bgColor="transparent")
UpdateBoundaryStyle($fontColor="#BFBFBF", $borderColor="#7A7A7A", $bgColor="transparent")



Container(MediTrack.APIGateway, "API Gateway", $techn="Spring Cloud Gateway, Azure Container Apps", $descr="Punto único de entrada: enruta peticiones, valida JWT y aplica rate limiting.", $tags="", $link="")
ContainerQueue(MediTrack.AzureServiceBus, "Azure Service Bus", $techn="Azure Service Bus, AMQP", $descr="Bus de eventos de dominio entre microservicios (topics y suscripciones, con dead-letter queue).", $tags="", $link="")
ContainerQueue(MediTrack.AzureIoTHub, "Azure IoT Hub", $techn="Azure IoT Hub, MQTT", $descr="Broker MQTT gestionado con identidad por dispositivo; expone un endpoint compatible con Event Hubs.", $tags="", $link="")
ContainerDb(MediTrack.CheckpointStore, "Checkpoint Store", $techn="Azure Blob Storage", $descr="Guarda el avance de lectura por partición para reanudar sin pérdida.", $tags="", $link="")
ContainerDb(MediTrack.MonitoringDB, "Monitoring DB", $techn="Azure Database for MySQL 8", $descr="Lecturas de signos vitales (particionadas por fecha) y alertas.", $tags="", $link="")

Container_Boundary("MediTrack.MonitoringService_boundary", "Monitoring Service", $tags="") {
  Component(MediTrack.MonitoringService.TelemetryConsumer, "Telemetry Consumer", $techn="Azure SDK EventProcessorClient", $descr="Consume las lecturas desde el endpoint compatible con Event Hubs de IoT Hub, con checkpoints por partición.", $tags="", $link="")
  Component(MediTrack.MonitoringService.ReadingValidator, "Reading Validator", $techn="Spring Bean", $descr="Valida rangos físicos y formato, normaliza unidades y descarta duplicados (deviceId + timestamp).", $tags="", $link="")
  Component(MediTrack.MonitoringService.DeviceDirectory, "Device Directory", $techn="Spring Bean, caché en memoria", $descr="Read model local deviceId -> adulto mayor y organización, actualizado por eventos DeviceAssigned.", $tags="", $link="")
  Component(MediTrack.MonitoringService.AlertRuleEngine, "Alert Rule Engine", $techn="Spring Bean", $descr="Evalúa umbrales por tipo de signo vital y detecta caídas (patrón Strategy).", $tags="", $link="")
  Component(MediTrack.MonitoringService.VitalSignRepository, "Vital Sign Repository", $techn="Spring Data JPA", $descr="Persiste y consulta lecturas en tablas particionadas por fecha.", $tags="", $link="")
  Component(MediTrack.MonitoringService.AlertRepository, "Alert Repository", $techn="Spring Data JPA", $descr="Persiste alertas y su ciclo de vida.", $tags="", $link="")
  Component(MediTrack.MonitoringService.AlertPublisher, "Alert Publisher", $techn="Spring Cloud Azure Service Bus", $descr="Publica el evento AlertRaised en el topic de alertas.", $tags="", $link="")
  Component(MediTrack.MonitoringService.VitalSignsController, "Vital Signs Controller", $techn="Spring REST Controller", $descr="GET/POST /api/v1/devices/{deviceId}/heart-rates | oxygens | blood-pressures | temperatures", $tags="", $link="")
  Component(MediTrack.MonitoringService.AlertsController, "Alerts Controller", $techn="Spring REST Controller", $descr="GET /api/v1/alerts, /api/v1/alerts/{alertId}, /api/v1/devices/{deviceId}/alerts; PATCH /api/v1/alerts/{alertId}/status", $tags="", $link="")
  Component(MediTrack.MonitoringService.DeviceAssignmentListener, "Device Assignment Listener", $techn="Spring Cloud Azure Service Bus", $descr="Escucha DeviceAssigned / DeviceUnassigned y actualiza el Device Directory.", $tags="", $link="")
}

Rel(MediTrack.MonitoringService.TelemetryConsumer, MediTrack.AzureIoTHub, "Lee lecturas", $techn="AMQP (Event Hubs-compatible)", $tags="", $link="")
Rel(MediTrack.MonitoringService.TelemetryConsumer, MediTrack.CheckpointStore, "Guarda checkpoints", $techn="HTTPS", $tags="", $link="")
Rel(MediTrack.MonitoringService.TelemetryConsumer, MediTrack.MonitoringService.ReadingValidator, "Entrega lectura", $techn="", $tags="", $link="")
Rel(MediTrack.MonitoringService.ReadingValidator, MediTrack.MonitoringService.DeviceDirectory, "Resuelve adulto mayor y organización", $techn="", $tags="", $link="")
Rel(MediTrack.MonitoringService.ReadingValidator, MediTrack.MonitoringService.VitalSignRepository, "Persiste lectura válida", $techn="", $tags="", $link="")
Rel(MediTrack.MonitoringService.ReadingValidator, MediTrack.MonitoringService.AlertRuleEngine, "Evalúa lectura", $techn="", $tags="", $link="")
Rel(MediTrack.MonitoringService.AlertRuleEngine, MediTrack.MonitoringService.AlertRepository, "Registra alerta", $techn="", $tags="", $link="")
Rel(MediTrack.MonitoringService.AlertRuleEngine, MediTrack.MonitoringService.AlertPublisher, "Solicita publicación", $techn="", $tags="", $link="")
Rel(MediTrack.MonitoringService.AlertPublisher, MediTrack.AzureServiceBus, "Publica AlertRaised", $techn="AMQP", $tags="", $link="")
Rel(MediTrack.MonitoringService.DeviceAssignmentListener, MediTrack.AzureServiceBus, "Consume DeviceAssigned", $techn="AMQP", $tags="", $link="")
Rel(MediTrack.MonitoringService.DeviceAssignmentListener, MediTrack.MonitoringService.DeviceDirectory, "Actualiza", $techn="", $tags="", $link="")
Rel(MediTrack.MonitoringService.VitalSignRepository, MediTrack.MonitoringDB, "Lee/escribe", $techn="JDBC", $tags="", $link="")
Rel(MediTrack.MonitoringService.AlertRepository, MediTrack.MonitoringDB, "Lee/escribe", $techn="JDBC", $tags="", $link="")
Rel(MediTrack.APIGateway, MediTrack.MonitoringService.VitalSignsController, "Enruta signos vitales", $techn="HTTPS", $tags="", $link="")
Rel(MediTrack.APIGateway, MediTrack.MonitoringService.AlertsController, "Enruta alertas", $techn="HTTPS", $tags="", $link="")
Rel(MediTrack.MonitoringService.VitalSignsController, MediTrack.MonitoringService.VitalSignRepository, "Consulta", $techn="", $tags="", $link="")
Rel(MediTrack.MonitoringService.AlertsController, MediTrack.MonitoringService.AlertRepository, "Consulta", $techn="", $tags="", $link="")


@enduml
